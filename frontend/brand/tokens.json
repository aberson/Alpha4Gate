{
  "$description": "Alpha4Gate frontend brand tokens. Hand-filled from frontend/src/index.css :root (light source of truth) and the named palette constants in the Models-tab components (on-brand pilot Step 16). The app flips light/dark via prefers-color-scheme, so color overrides for dark mode live in modes.dark.json. Favicon brand purple (#863bff) is carried as a named token.",
  "$extensions": {
    "onbrand": {
      "schemaVersion": 1
    }
  },
  "color": {
    "$type": "color",
    "semantic": {
      "bg": { "$value": "#ffffff", "$description": "Page background (--bg)." },
      "text": { "$value": "#6b6375", "$description": "Primary body text (--text)." },
      "text-h": { "$value": "#08060d", "$description": "Heading text (--text-h)." },
      "border": { "$value": "#e5e4e7", "$description": "Divider / panel edge (--border)." },
      "code-bg": { "$value": "#f4f3ec", "$description": "Inline code fill (--code-bg)." },
      "accent": { "$value": "#aa3bff", "$description": "Interactive accent (--accent)." },
      "accent-bg": { "$value": "#aa3bff1a", "$description": "Accent fill at ~10% (--accent-bg)." },
      "accent-border": { "$value": "#aa3bff80", "$description": "Accent border at ~50% (--accent-border)." },
      "social-bg": { "$value": "#f4f3ec80", "$description": "Social-row fill at ~50% (--social-bg)." },
      "favicon-purple": { "$value": "#863bff", "$description": "Fixed brand purple used by the favicon glyph; mode-independent." }
    },
    "status": {
      "info": { "fg": { "$value": "#60a5fa", "$description": "Info severity foreground (App.css .severity-info)." } },
      "warning": { "fg": { "$value": "#f59e0b", "$description": "Warning severity foreground (App.css .severity-warning)." } },
      "danger": { "fg": { "$value": "#e53e3e", "$description": "Error/danger foreground; chart error red." } }
    },
    "process-status": {
      "$description": "ProcessMonitor STATUS_COLORS badge fills (white text sits on them).",
      "running": { "$value": "#2ecc71" },
      "stopped": { "$value": "#888888" },
      "stale": { "$value": "#e74c3c" },
      "unknown": { "$value": "#f39c12" }
    },
    "harness": {
      "$description": "Per-harness accent border colors (LiveRunsGrid HARNESS_ACCENT); identity colors, mode-independent.",
      "training-daemon": { "$value": "#3498db" },
      "advised": { "$value": "#f1c40f" },
      "evolve": { "$value": "#16a085" },
      "self-play": { "$value": "#9b59b6" }
    },
    "chart": {
      "categorical": {
        "$description": "8 distinguishable series colors (VersionInspector LAYER_PALETTE), in order.",
        "1": { "$value": "#3182ce" },
        "2": { "$value": "#38a169" },
        "3": { "$value": "#e53e3e" },
        "4": { "$value": "#805ad5" },
        "5": { "$value": "#ed8936" },
        "6": { "$value": "#319795" },
        "7": { "$value": "#d53f8c" },
        "8": { "$value": "#48bb78" }
      },
      "chrome": {
        "$description": "Recharts chrome (grid/axis/label/tooltip). LIGHT values here; modes.dark.json flips them for dark mode.",
        "grid": { "$value": "#e5e4e7", "$description": "CartesianGrid stroke." },
        "axis": { "$value": "#9ca3af", "$description": "XAxis/YAxis stroke." },
        "label": { "$value": "#6b6375", "$description": "Axis / tooltip label text." },
        "tooltip-bg": { "$value": "#ffffff", "$description": "Tooltip content background." }
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": { "$value": ["system-ui", "Segoe UI", "Roboto", "sans-serif"] },
    "heading": { "$value": ["system-ui", "Segoe UI", "Roboto", "sans-serif"] },
    "mono": { "$value": ["ui-monospace", "Consolas", "monospace"] }
  }
}
