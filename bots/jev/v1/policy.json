      "id": "economy",
      "label": "Economy: keep idle probes mining",
      "kind": "sequence",
      "children": [
        "economy.idle_probes",
        "economy.mineral_patches",
        "economy.assign"
      ],
      "operation": null,
      "args": {}
    },
    {
      "id": "economy.idle_probes",
      "label": "Idle probes not held by a task",
      "kind": "select",
      "children": [],
      "operation": "select_entities",
      "args": {
        "collection": "own_units",
        "filter": {
          "types": [
            "Probe"
          ],
          "idle": true
        },
        "sort": {
          "by": "tag"
        },
        "limit": 32,
        "exclude_busy": true,
        "bind": "idle_probes"
      }
    },
    {
      "id": "economy.mineral_patches",
      "label": "Visible mineral patches near the main, nearest first",
      "kind": "select",
      "children": [],
      "operation": "select_entities",
      "args": {
        "collection": "mineral_fields",
        "filter": {
          "within": {
            "point": "start_location",
            "distance": 12
          }
        },
        "sort": {
          "by": "distance",
          "from": "start_location"
        },
        "limit": 8,
        "bind": "patches"
      }
    },
    {
      "id": "economy.assign",
      "label": "Send each idle probe to the least-loaded patch",
      "kind": "action",
      "children": [],
      "operation": "gather",
      "args": {
        "workers": "$idle_probes",
        "minerals": "$patches",
        "per_patch": {
          "param": "workers_per_patch"
        }
      }
    },
