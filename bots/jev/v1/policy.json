{
  "schema_version": 1,
  "family": "jev",
  "version": 1,
  "roots": [
    "economy",
    "construction",
    "production",
    "army"
  ],
  "parameters": {
    "probe_target": 16,
    "gateway_target": 4,
    "first_attack_zealots": 4,
