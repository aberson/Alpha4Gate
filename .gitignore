# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
.venv/
.venv-py312/
.venv-linux/
venv/

# Environment
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code local settings (per-developer permission overrides)
.claude/settings.local.json

# Soak monitor gist ID (per-developer; written by scripts/publish_soak_state.py)
.soak-monitor-gist.id

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Project data (local only)
logs/
replays/
# Legacy root-level data/ — leave fully ignored (audit snapshots, backups).
# Scoped to the root so `bots/*/data/` below can use negation for tracked
# config files.
/data/
# Snapshot/backup parent dir — operator manual snapshots
# (data-pre-soak-*, data-post-soak-*) and skill-auto backups
# (data.bak-*, data.demo-snapshot-*) all live here. README is tracked so
# the convention is documented; everything else is gitignored.
/data-snapshots/*
!/data-snapshots/README.md

# Versioned bot data (Step 1.8+) — runtime state ignored, config tracked.
/bots/*/data/**
!/bots/*/data/hyperparams.json
!/bots/*/data/reward_rules.json
!/bots/*/data/build_orders/
!/bots/*/data/build_orders/*.json
!/bots/*/data/reward_rules.pre-phase-d-*.json

# Evolve scratch dirs — `bots/cand_<hash>/` are temporary candidate
# snapshots created during fitness eval. They get rmtree'd at the end
# of each round but a killed run can leave them behind. Never commit.
/bots/cand_*/

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/

# Bot data backups (operator manual snapshots outside bots/*/data/)
/bots/*/data.backup-*/

# mypy
.mypy_cache/

# pytest
.pytest_cache/

# ruff
.ruff_cache/

# UI/UAT evidence dirs (agent-driven review/judge capture output, never committed)
.ui-review-evidence/
.ui-dashboard-evidence/
# /judge-motion run artifacts (a4g-motion adapter) - append-only capture runs
.judge-motion/

# Raw capture files — only cropped/optimized GIFs should be committed in documentation/images/
documentation/images/*.mp4
documentation/images/*.mov

# plan-expedite resume state (transient, session-local)
.plan-expedite-state
.plan-expedite-state.*

# Agent scratch from /build-step and /build-phase runs (reports, prewrap checks).
# Not gitignored historically, which put 6 scratch files one `git add -A` away
# from being committed. Never intended for version control.
.build-step/
.claude/task-state/.checkpoint-nudge-stamp
.claude/task-state/handoff-prompt.md
